# ==============================================================================
# CHAMSPA CRM - CẤU HÌNH GMAIL SMTP GỬI EMAIL ĐỔI MẬT KHẨU
# ==============================================================================
# Hướng dẫn lấy Mật khẩu ứng dụng (App Password) từ Google:
# 1. Truy cập tài khoản Google: https://myaccount.google.com/security
# 2. Bật "Xác minh 2 bước" (2-Step Verification) nếu chưa bật.
# 3. Tìm kiếm "Mật khẩu ứng dụng" (App Passwords) hoặc truy cập trực tiếp:
#    https://myaccount.google.com/apppasswords
# 4. Đặt tên ứng dụng (VD: "ChamSpa CRM") và nhấn "Tạo" (Create).
# 5. Google sẽ cấp mã 16 ký tự (VD: "abcd efgh ijkl mnop").
# 6. Sao chép và dán vào EMAIL_HOST_PASSWORD bên dưới (bỏ khoảng trắng).
# ==============================================================================

EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=abcdefghijklmnop
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="Cham Spa & Massage <your_email@gmail.com>"

# ==============================================================================
# CẤU HÌNH DOMAIN KHI DEPLOY LÊN PRODUCTION (Render, Railway, VPS, Custom domain...)
# Ví dụ: SITE_URL=https://chamspa.com.vn hoặc SITE_URL=https://chamspa.onrender.com
# Nếu để trống, hệ thống sẽ tự động bắt domain từ trình duyệt của khách hàng.
# ==============================================================================
SITE_URL=

